parameters:
	level: 9
	reportUnmatchedIgnoredErrors: false
	paths:
		- src
		- tests
		- config

	# PHPDoc of the newest dependency versions, so that the lowest and the latest dependencies are analysed alike
	stubFiles:
		- stubs/Type.stub

	scanFiles:
	    - vendor/symfony/dependency-injection/Loader/Configurator/ContainerConfigurator.php

	# Code built on a newer temporal/sdk than the lowest supported one (2.16).
	# PHPStan cannot ignore an unknown parent class or interface: those files are excluded
	excludePaths:
		analyse:
			- src/DataConverter/SerializationContextAwareSymfonyConverter.php
			- tests/Functional/Plugin/*

	ignoreErrors:
		-
			identifiers: [class.notFound, method.notFound, argument.type]
			paths:
				- tests/Unit/DataConverter/SerializationContextAwareSymfonyConverterTest.php

		# Migrations are opt-in and reject SDK < 2.18 before loading the Operator client.
		-
			message: '#Temporal\\Client\\GRPC\\OperatorClient(?:Interface)?#'
			identifier: class.notFound
			paths:
				- src/DependencyInjection/Compiler/MigrationCompilerPass.php
				- src/Migration/MigrationRunner.php
				- src/Migration/MigrationRpcContext.php
				- src/Migration/NamespaceBuilder.php
				- src/Migration/Scheme.php
				- src/Migration/SearchAttributeBuilder.php
				- tests/Unit/Migration/*
				- tests/E2e/MigrationTest.php
				- tests/E2e/Migration/*
