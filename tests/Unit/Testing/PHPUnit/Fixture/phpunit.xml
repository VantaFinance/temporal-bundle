<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../../../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../../../../../vendor/autoload.php"
         cacheResult="false">
    <testsuites>
        <testsuite name="Scenarios">
            <file>Scenarios.php</file>
        </testsuite>
    </testsuites>
    <extensions>
        <bootstrap class="Vanta\Integration\Symfony\Temporal\Testing\PHPUnit\TemporalEnvironmentExtension">
            <parameter name="logFile" value="tests/Unit/Testing/PHPUnit/Fixture/nested/test-environment.log"/>
        </bootstrap>
    </extensions>
</phpunit>
